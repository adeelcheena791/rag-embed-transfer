# Only the TOP-LEVEL run-output folders are ignored (leading "/" anchors to the repo root).
# Unanchored "data/" previously also matched src/data/ and hid source code from git.
# tests/test_repo_layout.py fails if any source file is ignored or untracked.
/data/
/results/
/logs/

# Python caches (safe anywhere: never source code)
__pycache__/
*.pyc
.pytest_cache/

# analysis outputs: released deliberately at the end, not committed piecemeal
/tables/
/figures/
/paper/figures/
/paper/tables/
/paper/derived_stats.json
paper/latex/*.aux
paper/latex/*.log
paper/latex/*.bbl
paper/latex/*.blg
paper/latex/*.fls
paper/latex/*.fdb_latexmk
paper/latex/*.out
paper/latex/main.pdf
